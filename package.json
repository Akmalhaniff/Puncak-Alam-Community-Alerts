{
  "name": "puncak-alam-community-alerts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A simple community map for sharing flood, heavy-rain, and road-condition observations around Puncak Alam.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.js",
